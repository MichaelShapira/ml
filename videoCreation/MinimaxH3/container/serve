#!/usr/bin/env bash
# SageMaker hosting entrypoint: `docker run <image> serve`.
set -euo pipefail

echo "=== MiniMax-H3 SageMaker container starting $(date -Is) ==="
echo "sglang commit: $(cat /etc/sglang-commit 2>/dev/null || echo unknown)"
echo "python: $(python3 --version)"
python3 - <<'PY' || true
import torch
print("torch", torch.__version__, "cuda", torch.version.cuda, "gpus", torch.cuda.device_count())
PY

exec python3 -u /opt/h3/serve.py
